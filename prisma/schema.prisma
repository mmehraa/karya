datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id                       String   @id @default(uuid())
  name                     String
  slug                     String   @unique
  tagline                  String?
  description              String?
  industry                 String   @default("Other")
  constitution             String?
  countryCode              String?
  currentStageId           Int      @default(0)
  founderStageAssessmentId Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  currentStage                     StageDefinition                    @relation("BusinessCurrentStage", fields: [currentStageId], references: [id], onDelete: Restrict)
  founderStageAssessment           StageDefinition?                   @relation("BusinessFounderStageAssessment", fields: [founderStageAssessmentId], references: [id], onDelete: SetNull)
  settings                         BusinessSettings?
  stageProgress                    BusinessStageProgress[]
  stageTransitions                 StageTransition[]
  products                         Product[]
  productFormulations              ProductFormulation[]
  productFormulationItems          ProductFormulationItem[]
  productPackagingConfigurations   ProductPackagingConfiguration[]
  productPackagingConfigurationItems ProductPackagingConfigurationItem[]
  customers                        Customer[]
  orders                           Order[]
  orderItems                       OrderItem[]
  expenses                         Expense[]
  cashTransactions                 CashTransaction[]
  contentItems                     ContentItem[]
  contentPubs                      ContentPublication[]
  goals                            Goal[]
  tasks                            Task[]
  alerts                           Alert[]
  inventoryLedger                  InventoryTransaction[]
  promotionalDispatches            PromotionalDispatch[]
  investorMarketAssumptions        InvestorMarketAssumption[]
  investorVerifiedCashBalances     InvestorVerifiedCashBalance[]

  rawMaterials                     RawMaterial[]
  rawMaterialPurchases             RawMaterialPurchase[]
  rawMaterialInventoryTransactions RawMaterialInventoryTransaction[]

  packagingMaterials                     PackagingMaterial[]
  packagingMaterialPurchases             PackagingMaterialPurchase[]
  packagingMaterialInventoryTransactions PackagingMaterialInventoryTransaction[]

  productionBatches                    ProductionBatch[]
  productionBatchRawMaterialConsumptions ProductionBatchRawMaterialConsumption[]
  productionBatchPackagingConsumptions   ProductionBatchPackagingConsumption[]

  @@index([slug])
  @@index([currentStageId])
  @@index([founderStageAssessmentId])
}

model BusinessSettings {
  id                String   @id @default(uuid())
  businessId        String   @unique
  currencyCode      String   @default("INR")
  currencySymbol    String   @default("₹")
  fiscalYearStart   Int      @default(4)
  orderPrefix       String   @default("PR-")
  nextOrderNumber   Int      @default(1001)
  supportEmail      String?
  supportPhone      String?
  lowStockThreshold Int      @default(20)
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

enum RequirementType {
  MANDATORY
  RECOMMENDED
  OPTIONAL
}

enum RequirementStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum EvaluationMode {
  MANUAL
  METRIC_THRESHOLD
  SYSTEM_CHECK
}

model StageDefinition {
  id                 Int                   @id
  name               String                @unique
  description        String
  requirements       StageRequirementDef[]
  businessesInStage  Business[]            @relation("BusinessCurrentStage")
  founderAssessments Business[]            @relation("BusinessFounderStageAssessment")
  transitionsFrom    StageTransition[]     @relation("TransitionFromStage")
  transitionsTo      StageTransition[]     @relation("TransitionToStage")
}

model StageRequirementDef {
  id          String          @id @default(uuid())
  stageId     Int
  code        String          @unique
  title       String
  description String
  type        RequirementType @default(MANDATORY)
  evalMode    EvaluationMode  @default(MANUAL)
  evalRuleKey String?
  evalConfig  Json?
  orderIndex  Int             @default(0)

  stageDefinition  StageDefinition         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  businessProgress BusinessStageProgress[]

  @@index([stageId, type])
}

model BusinessStageProgress {
  id            String            @id @default(uuid())
  businessId    String
  requirementId String
  status        RequirementStatus @default(NOT_STARTED)
  completedAt   DateTime?
  blockerReason String?
  notes         String?
  updatedAt     DateTime          @updatedAt

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requirement StageRequirementDef @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([businessId, requirementId])
  @@index([businessId, status])
}

model StageTransition {
  id          String   @id @default(uuid())
  businessId  String
  fromStageId Int
  toStageId   Int
  reason      String
  triggeredBy String   @default("Founder")
  createdAt   DateTime @default(now())

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromStage StageDefinition @relation("TransitionFromStage", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStage   StageDefinition @relation("TransitionToStage", fields: [toStageId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([fromStageId])
  @@index([toStageId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id          String  @id @default(uuid())
  businessId  String
  name        String
  sku         String
  category    String  @default("Skincare")
  description String?

  sellingPrice  Decimal? @db.Decimal(12, 2)
  cogs          Decimal? @db.Decimal(12, 2)
  packagingCost Decimal? @db.Decimal(12, 2)
  variableCost  Decimal? @db.Decimal(12, 2)

  currentStock     Int @default(0)
  promotionalStock Int @default(0)
  reorderLevel     Int @default(20)

  supplier String?
  status   ProductStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business                Business                         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems              OrderItem[]
  stockEntries            InventoryTransaction[]
  promotionalDispatches   PromotionalDispatch[]
  formulations            ProductFormulation[]
  packagingConfigurations ProductPackagingConfiguration[]
  productionBatches       ProductionBatch[]

  @@unique([businessId, id])
  @@unique([businessId, sku])
  @@index([businessId, status])
}

model ProductFormulation {
  id         String  @id @default(uuid())
  businessId String
  productId  String

  name     String  @default("Default Formulation")
  version  Int     @default(1)
  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business          Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product                    @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  items             ProductFormulationItem[]
  productionBatches ProductionBatch[]

  @@unique([businessId, id])
  @@unique([businessId, productId, version])
  @@index([businessId, productId])
  @@index([businessId, isActive])
}

model ProductFormulationItem {
  id            String  @id @default(uuid())
  businessId    String
  formulationId String
  rawMaterialId String

  quantity Decimal @db.Decimal(16, 6)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  formulation ProductFormulation @relation(fields: [formulationId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial        @relation(fields: [businessId, rawMaterialId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, formulationId, rawMaterialId])
  @@unique([businessId, id])
  @@index([businessId, formulationId])
  @@index([businessId, rawMaterialId])
}

model ProductPackagingConfiguration {
  id         String  @id @default(uuid())
  businessId String
  productId  String

  name     String  @default("Default Packaging")
  version  Int     @default(1)
  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business          Business                           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product           Product                            @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  items             ProductPackagingConfigurationItem[]
  productionBatches ProductionBatch[]

  @@unique([businessId, id])
  @@unique([businessId, productId, version])
  @@index([businessId, productId])
  @@index([businessId, isActive])
}

model ProductPackagingConfigurationItem {
  id                  String  @id @default(uuid())
  businessId          String
  configurationId     String
  packagingMaterialId String

  quantity Decimal @db.Decimal(16, 6)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business          Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  configuration     ProductPackagingConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  packagingMaterial PackagingMaterial             @relation(fields: [businessId, packagingMaterialId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, configurationId, packagingMaterialId])
  @@unique([businessId, id])
  @@index([businessId, configurationId])
  @@index([businessId, packagingMaterialId])
}

enum RawMaterialBaseUnit {
  GRAM
  MILLILITER
  PIECE
}

enum RawMaterialPurchaseUnit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE
}

enum RawMaterialInventoryTransactionType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model RawMaterial {
  id         String             @id @default(uuid())
  businessId String
  name       String
  category   String?
  baseUnit   RawMaterialBaseUnit
  supplier   String?
  notes      String?

  currentQuantity     Decimal @default(0) @db.Decimal(16, 3)
  currentValue        Decimal @default(0) @db.Decimal(16, 2)
  weightedAverageCost Decimal @default(0) @db.Decimal(16, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business               Business                             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases              RawMaterialPurchase[]
  transactions           RawMaterialInventoryTransaction[]
  formulationItems       ProductFormulationItem[]
  productionConsumptions ProductionBatchRawMaterialConsumption[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@index([businessId, category])
  @@index([businessId, supplier])
}

model RawMaterialPurchase {
  id            String  @id @default(uuid())
  businessId    String
  rawMaterialId String

  purchaseDate    DateTime
  quantity        Decimal                   @db.Decimal(16, 3)
  purchaseUnit    RawMaterialPurchaseUnit
  baseQuantity    Decimal                   @db.Decimal(16, 3)
  totalAmount     Decimal                   @db.Decimal(12, 2)
  costPerBaseUnit Decimal                   @db.Decimal(16, 6)

  supplier         String?
  invoiceReference String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business             Business                         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rawMaterial          RawMaterial                      @relation(fields: [businessId, rawMaterialId], references: [businessId, id], onDelete: Restrict)
  inventoryTransaction RawMaterialInventoryTransaction? @relation("RawMaterialPurchaseTransaction")

  @@index([businessId, purchaseDate])
  @@index([businessId, rawMaterialId, purchaseDate])
}

model RawMaterialInventoryTransaction {
  id            String                              @id @default(uuid())
  businessId    String
  rawMaterialId String

  type       RawMaterialInventoryTransactionType
  quantity   Decimal @db.Decimal(16, 3)
  unitCost   Decimal @db.Decimal(16, 6)
  totalValue Decimal @db.Decimal(16, 2)

  purchaseId String? @unique

  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())

  business    Business                            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial                         @relation(fields: [businessId, rawMaterialId], references: [businessId, id], onDelete: Restrict)
  purchase    RawMaterialPurchase?                @relation("RawMaterialPurchaseTransaction", fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([businessId, rawMaterialId, createdAt])
  @@index([businessId, type])
}

enum PackagingMaterialBaseUnit {
  PIECE
}

enum PackagingMaterialPurchaseUnit {
  PIECE
  PACK
  BOX
  BUNDLE
  CARTON
}

enum PackagingMaterialInventoryTransactionType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model PackagingMaterial {
  id         String @id @default(uuid())
  businessId String
  name       String
  category   String?
  baseUnit   PackagingMaterialBaseUnit
  supplier   String?
  notes      String?

  currentQuantity     Decimal @default(0) @db.Decimal(16, 3)
  currentValue        Decimal @default(0) @db.Decimal(16, 6)
  weightedAverageCost Decimal @default(0) @db.Decimal(16, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business                    Business                                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases                   PackagingMaterialPurchase[]
  transactions               PackagingMaterialInventoryTransaction[]
  packagingConfigurationItems ProductPackagingConfigurationItem[]
  productionConsumptions      ProductionBatchPackagingConsumption[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@index([businessId, category])
  @@index([businessId, supplier])
}

model PackagingMaterialPurchase {
  id                  String @id @default(uuid())
  businessId          String
  packagingMaterialId String

  purchaseDate         DateTime
  quantity             Decimal                   @db.Decimal(16, 3)
  purchaseUnit         PackagingMaterialPurchaseUnit
  unitsPerPurchaseUnit Decimal                   @db.Decimal(16, 3)
  baseQuantity         Decimal                   @db.Decimal(16, 3)
  totalAmount          Decimal                   @db.Decimal(12, 2)
  costPerBaseUnit      Decimal                   @db.Decimal(16, 6)

  supplier         String?
  invoiceReference String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business             Business                               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packagingMaterial    PackagingMaterial                      @relation(fields: [businessId, packagingMaterialId], references: [businessId, id], onDelete: Restrict)
  inventoryTransaction PackagingMaterialInventoryTransaction? @relation("PackagingMaterialPurchaseTransaction")

  @@index([businessId, purchaseDate])
  @@index([businessId, packagingMaterialId, purchaseDate])
}

model PackagingMaterialInventoryTransaction {
  id                  String                                  @id @default(uuid())
  businessId          String
  packagingMaterialId String

  type       PackagingMaterialInventoryTransactionType
  quantity   Decimal @db.Decimal(16, 3)
  unitCost   Decimal @db.Decimal(16, 6)
  totalValue Decimal @db.Decimal(16, 6)

  purchaseId String? @unique

  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())

  business          Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packagingMaterial PackagingMaterial           @relation(fields: [businessId, packagingMaterialId], references: [businessId, id], onDelete: Restrict)
  purchase          PackagingMaterialPurchase?  @relation("PackagingMaterialPurchaseTransaction", fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([businessId, packagingMaterialId, createdAt])
  @@index([businessId, type])
}

enum ProductionBatchStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model ProductionBatch {
  id                       String               @id @default(uuid())
  businessId               String
  productId                String
  formulationId            String
  packagingConfigurationId String

  batchNumber     String
  plannedQuantity Int
  producedQuantity Int?
  status          ProductionBatchStatus @default(DRAFT)

  rawMaterialCost       Decimal? @db.Decimal(16, 6)
  packagingMaterialCost Decimal? @db.Decimal(16, 6)
  totalCost             Decimal? @db.Decimal(16, 6)
  costPerUnit           Decimal? @db.Decimal(16, 6)

  completedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business               Business                       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product                Product                        @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  formulation            ProductFormulation             @relation(fields: [businessId, formulationId], references: [businessId, id], onDelete: Restrict)
  packagingConfiguration ProductPackagingConfiguration @relation(fields: [businessId, packagingConfigurationId], references: [businessId, id], onDelete: Restrict)

  rawMaterialConsumptions ProductionBatchRawMaterialConsumption[]
  packagingConsumptions   ProductionBatchPackagingConsumption[]

  @@unique([businessId, id])
  @@unique([businessId, batchNumber])
  @@index([businessId, productId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([businessId, formulationId])
  @@index([businessId, packagingConfigurationId])
}

model ProductionBatchRawMaterialConsumption {
  id            String @id @default(uuid())
  businessId    String
  batchId       String
  rawMaterialId String

  quantity  Decimal @db.Decimal(16, 6)
  unitCost  Decimal @db.Decimal(16, 6)
  totalCost Decimal @db.Decimal(16, 6)
  notes     String?

  createdAt DateTime @default(now())

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  batch       ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial     @relation(fields: [businessId, rawMaterialId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, batchId, rawMaterialId])
  @@index([businessId, batchId])
  @@index([businessId, rawMaterialId, createdAt])
}

model ProductionBatchPackagingConsumption {
  id                  String @id @default(uuid())
  businessId          String
  batchId             String
  packagingMaterialId String

  quantity  Decimal @db.Decimal(16, 6)
  unitCost  Decimal @db.Decimal(16, 6)
  totalCost Decimal @db.Decimal(16, 6)
  notes     String?

  createdAt DateTime @default(now())

  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  batch             ProductionBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  packagingMaterial PackagingMaterial @relation(fields: [businessId, packagingMaterialId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, batchId, packagingMaterialId])
  @@index([businessId, batchId])
  @@index([businessId, packagingMaterialId, createdAt])
}

enum InventoryTransactionType {
  INITIAL_STOCK
  PRODUCTION_RUN
  PURCHASE_RESTOCK
  SALE
  RETURN_RESTOCK
  DAMAGED_WRITE_OFF
  MANUAL_AUDIT
  PROMOTIONAL_DISPATCH
}

model InventoryTransaction {
  id          String                   @id @default(uuid())
  businessId  String
  productId   String
  type        InventoryTransactionType
  quantity    Int
  unitCost    Decimal?                 @db.Decimal(16, 6)
  referenceId String?
  notes       String?
  createdAt   DateTime                 @default(now())

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  promotionalDispatch PromotionalDispatch? @relation("PromotionalDispatchInventoryTransaction")

  @@index([businessId, productId, createdAt])
  @@index([businessId, type])
}

enum OrderPaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum OrderFulfillmentStatus {
  PENDING
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Customer {
  id         String   @id @default(uuid())
  businessId String
  name       String
  email      String?
  phone      String?
  city       String?
  state      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([businessId, id])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, createdAt])
}

model Order {
  id          String   @id @default(uuid())
  businessId  String
  customerId  String
  orderNumber String
  orderDate   DateTime @default(now())

  paymentStatus     OrderPaymentStatus     @default(PENDING)
  fulfillmentStatus OrderFulfillmentStatus @default(PENDING)

  subtotal        Decimal @db.Decimal(12, 2)
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  shippingCharged Decimal @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal @db.Decimal(12, 2)

  channel       String   @default("Direct")
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  items    OrderItem[]

  @@unique([businessId, id])
  @@unique([businessId, orderNumber])
  @@index([businessId, orderDate, paymentStatus])
  @@index([businessId, customerId])
}

model OrderItem {
  id         String  @id @default(uuid())
  businessId String
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)

  costPriceSnapshot Decimal @db.Decimal(16, 6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [businessId, orderId], references: [businessId, id], onDelete: Cascade)
  product  Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, orderId])
  @@index([businessId, productId])
}

enum ExpenseCategory {
  PRODUCT_FORMULATION
  PACKAGING
  PRINTING_LABELS
  SHIPPING
  MARKETING
  PROMOTIONAL
  FRIENDS_FAMILY
  EQUIPMENT
  WEBSITE_SOFTWARE
  LEGAL_COMPLIANCE
  OPERATIONS
  OTHER
}

model Expense {
  id            String          @id @default(uuid())
  businessId    String
  expenseDate   DateTime
  category      ExpenseCategory
  description   String
  amount        Decimal         @db.Decimal(12, 2)
  vendor        String?
  paymentMethod String?
  isRecurring   Boolean         @default(false)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  promotionalDispatch PromotionalDispatch? @relation("PromotionalDispatchExpense")

  @@index([businessId, expenseDate])
  @@index([businessId, category])
}

enum CashTransactionType {
  INFLOW
  OUTFLOW
}

enum CashTransactionCategory {
  CUSTOMER_PAYMENT
  OTHER_INCOME
  RAW_MATERIAL_PURCHASE
  PACKAGING_MATERIAL_PURCHASE
  OPERATING_EXPENSE
  SHIPPING
  PAYMENT_PROCESSING_FEE
  CUSTOMER_REFUND
  OTHER
}

model CashTransaction {
  id         String @id @default(uuid())
  businessId String

  transactionDate DateTime
  type            CashTransactionType
  category        CashTransactionCategory
  amount          Decimal @db.Decimal(12, 2)

  paymentMethod String?
  description   String
  referenceId   String?
  sourceType    String?
  sourceId      String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, transactionDate])
  @@index([businessId, type, transactionDate])
  @@index([businessId, category, transactionDate])
  @@index([businessId, sourceType, sourceId])
}

model PromotionalDispatch {
  id                     String   @id @default(uuid())
  businessId             String
  productId              String
  quantity               Int
  recipient              String
  purpose                String
  referenceId            String?
  unitCost               Decimal  @db.Decimal(12, 2)
  totalCost              Decimal  @db.Decimal(12, 2)
  inventoryTransactionId String   @unique
  expenseId              String   @unique
  createdAt              DateTime @default(now())

  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product              Product              @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  inventoryTransaction InventoryTransaction @relation("PromotionalDispatchInventoryTransaction", fields: [inventoryTransactionId], references: [id], onDelete: Restrict)
  expense              Expense              @relation("PromotionalDispatchExpense", fields: [expenseId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([businessId, productId, createdAt])
}

enum ContentPlatform {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  WHATSAPP
}

enum ContentType {
  REEL
  POST
  CAROUSEL
  STORY
  LONG_VIDEO
}

enum ContentStatus {
  IDEA
  SCRIPT
  SHOT
  EDITING
  READY
  SCHEDULED
  PUBLISHED
}

model ContentItem {
  id          String        @id @default(uuid())
  businessId  String
  title       String
  contentType ContentType   @default(REEL)
  status      ContentStatus @default(IDEA)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publications ContentPublication[]

  @@unique([businessId, id])
  @@index([businessId, status])
}

model ContentPublication {
  id            String          @id @default(uuid())
  businessId    String
  contentItemId String
  platform      ContentPlatform
  plannedDate   DateTime?
  publishedDate DateTime?
  url           String?

  views         Int @default(0)
  reach         Int @default(0)
  likes         Int @default(0)
  comments      Int @default(0)
  shares        Int @default(0)
  saves         Int @default(0)
  websiteClicks Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [businessId, contentItemId], references: [businessId, id], onDelete: Cascade)

  @@unique([contentItemId, platform])
  @@index([businessId, platform])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Goal {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  category     String
  targetValue  Decimal  @db.Decimal(12, 2)
  currentValue Decimal  @default(0) @db.Decimal(12, 2)
  unit         String   @default("Units")
  startDate    DateTime
  endDate      DateTime
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@unique([businessId, id])
  @@index([businessId, isCompleted])
}

model Task {
  id          String     @id @default(uuid())
  businessId  String
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  goalId      String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  goal     Goal?    @relation(fields: [businessId, goalId], references: [businessId, id], onDelete: SetNull)

  @@index([businessId, status, dueDate])
  @@index([businessId, priority])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id         String        @id @default(uuid())
  businessId String
  title      String
  message    String
  severity   AlertSeverity @default(WARNING)
  isResolved Boolean       @default(false)
  linkUrl    String?
  createdAt  DateTime      @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isResolved])
}

enum InvestorMarketType {
  TAM
  SAM
  SOM
}

enum InvestorMarketSourceType {
  USER_PROVIDED
  EXTERNAL_RESEARCH
}

model InvestorMarketAssumption {
  id                String                  @id @default(uuid())
  businessId        String
  market            InvestorMarketType
  value             Decimal                 @db.Decimal(20, 2)
  currencyCode      String                  @default("INR")
  marketDefinition  String
  geography         String
  methodology       String
  sourceType        InvestorMarketSourceType @default(USER_PROVIDED)
  sourceName        String?
  sourceUrl         String?
  asOfDate          DateTime
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, market, asOfDate])
  @@index([businessId, createdAt])
}

model InvestorVerifiedCashBalance {
  id                String   @id @default(uuid())
  businessId        String
  amount            Decimal  @db.Decimal(20, 2)
  currencyCode      String   @default("INR")
  asOfDate          DateTime
  sourceDescription String
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, asOfDate])
  @@index([businessId, createdAt])
}

